<style>
*{box-sizing:border-box}body{margin:0;background:#f5f7fb;color:#1f2937;font:16px/1.45 Arial,sans-serif}.topbar{padding:16px max(24px,calc((100% - 1000px)/2));background:#12355b;color:#fff;display:flex;gap:24px;align-items:center;justify-content:space-between}.brand{font-weight:bold;font-size:20px}.topbar a{color:#fff;text-decoration:none;margin-left:14px}.wrap{width:min(1000px,calc(100% - 32px));margin:34px auto}.card{background:#fff;padding:28px;border-radius:10px;box-shadow:0 2px 12px #0f172a15}.auth{width:min(480px,calc(100% - 32px));margin:50px auto}.field{display:grid;gap:6px;margin:14px 0}input{border:1px solid #cbd5e1;padding:10px;border-radius:6px;font:inherit}button,.btn{border:0;border-radius:6px;background:#0f766e;color:#fff;padding:10px 15px;font:inherit;cursor:pointer;text-decoration:none;display:inline-block}.btn.secondary{background:#475569}.btn.danger{background:#b91c1c}.alert{padding:12px;background:#fee2e2;color:#991b1b;border-radius:6px;margin:15px 0}.success{padding:12px;background:#dcfce7;color:#166534;border-radius:6px;margin:15px 0}table{border-collapse:collapse;width:100%;margin-top:20px}th,td{padding:11px;text-align:left;border-bottom:1px solid #e2e8f0}img.thumb{width:120px;height:75px;object-fit:cover;border-radius:4px}.actions{display:flex;gap:7px}.search{display:flex;gap:8px;align-items:center}@media(max-width:600px){.topbar{padding:16px;display:block}.topbar nav{margin-top:10px}.wrap{width:calc(100% - 20px)}.card{padding:18px}table{font-size:13px}}
</style>
<style>
.product-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.product-card{border:1px solid #e2e8f0;border-radius:8px;padding:14px;overflow-wrap:anywhere}.product-card a{color:#12355b}.product-image{width:100%;height:170px;object-fit:contain;background:#f5f7fb;border-radius:6px}.no-image{display:flex;align-items:center;justify-content:center;color:#64748b}.product-detail-image{max-width:100%;width:480px;max-height:400px;object-fit:contain}.product-description{white-space:pre-wrap;overflow-wrap:anywhere}.pagination{display:flex;align-items:center;gap:16px;margin-top:24px}.table-scroll{overflow-x:auto}.field textarea,.field select{border:1px solid #cbd5e1;padding:10px;border-radius:6px;font:inherit}.topbar nav{display:flex;gap:12px;flex-wrap:wrap;align-items:center}@media(max-width:700px){.product-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(max-width:450px){.product-grid{grid-template-columns:1fr}}
</style>
