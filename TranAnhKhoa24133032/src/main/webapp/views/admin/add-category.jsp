<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><!DOCTYPE html><html><head><title>Thêm Category</title><%@ include file="../includes/style.jsp" %></head><body><%@ include file="../includes/header.jsp" %><main class="wrap card"><h1>Thêm danh mục</h1><c:if test="${not empty alert}"><p class="alert"><c:out value="${alert}"/></p></c:if><form action="${pageContext.request.contextPath}/admin/category/add" method="post" enctype="multipart/form-data"><label class="field">Tên danh mục<input name="name" required></label><label class="field">Ảnh đại diện<input type="file" name="icon" accept="image/png,image/jpeg,image/gif,image/webp"></label><button type="submit">Thêm</button> <a class="btn secondary" href="${pageContext.request.contextPath}/admin/category/list">Hủy</a></form></main></body></html>
