<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><!DOCTYPE html><html><head><title>Danh sách Category</title><%@ include file="../includes/style.jsp" %></head><body><%@ include file="../includes/header.jsp" %><main class="wrap card"><h1>Quản lý danh mục</h1><div class="search"><a class="btn" href="${pageContext.request.contextPath}/admin/category/add">Thêm danh mục</a><form action="${pageContext.request.contextPath}/admin/category/list" method="get"><input name="keyword" value="<c:out value='${param.keyword}'/>" placeholder="Tìm tên danh mục"><button>Tìm</button></form></div><table><thead><tr><th>STT</th><th>Ảnh đại diện</th><th>Tên danh mục</th><th>Thao tác</th></tr></thead><tbody><c:forEach items="${cateList}" var="cate" varStatus="st"><tr><td>${st.index + 1}</td><td><c:choose><c:when test="${not empty cate.icon}"><c:url value="/image" var="imgUrl"><c:param name="fname" value="${cate.icon}"/></c:url><img class="thumb" src="${imgUrl}" alt="${cate.name}"></c:when><c:otherwise>Không có ảnh</c:otherwise></c:choose></td><td><c:out value="${cate.name}"/></td><td class="actions"><a class="btn secondary" href="${pageContext.request.contextPath}/admin/category/edit?id=${cate.id}">Sửa</a><a class="btn danger" href="${pageContext.request.contextPath}/admin/category/delete?id=${cate.id}" onclick="return confirm('Xóa danh mục này?')">Xóa</a></td></tr></c:forEach><c:if test="${empty cateList}"><tr><td colspan="4">Chưa có danh mục.</td></tr></c:if></tbody></table></main></body></html>
