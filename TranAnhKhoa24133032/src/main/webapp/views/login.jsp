<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Đăng nhập</title><%@ include file="includes/style.jsp" %></head><body><main class="card auth"><h1>Đăng nhập</h1><c:if test="${param.reset == '1'}"><p class="success">Đặt lại mật khẩu thành công. Hãy đăng nhập bằng mật khẩu mới.</p></c:if><c:if test="${param.activated == '1'}"><p class="success">Kích hoạt thành công. Hãy đăng nhập để tiếp tục.</p></c:if><c:if test="${not empty alert}"><p class="alert"><c:out value="${alert}"/></p></c:if><c:if test="${param.activation == '1'}"><p class="alert">Vui lòng đăng nhập bằng tài khoản chưa kích hoạt để tiếp tục xác nhận OTP.</p></c:if><c:if test="${activationRequired}"><p><a href="${pageContext.request.contextPath}/verify-otp">Nhập OTP / Gửi lại OTP</a></p></c:if><form action="${pageContext.request.contextPath}/login" method="post"><label class="field">Tài khoản<input name="username" required></label><label class="field">Mật khẩu<input type="password" name="password" required></label><label><input type="checkbox" name="remember"> Ghi nhớ đăng nhập (30 phút)</label><p><button type="submit">Đăng nhập</button></p></form><p><a href="${pageContext.request.contextPath}/forgot-password">Quên mật khẩu?</a></p><p>Chưa có tài khoản? <a href="${pageContext.request.contextPath}/register">Đăng ký</a></p></main></body></html>


