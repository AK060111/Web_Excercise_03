<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!DOCTYPE html><html><head><title>Đăng ký</title><%@ include file="includes/style.jsp" %></head><body><main class="card auth"><h1>Tạo tài khoản mới</h1><p>Sau khi đăng ký, hãy nhập OTP gửi qua email để kích hoạt tài khoản.</p><c:if test="${not empty alert}"><p class="alert"><c:out value="${alert}"/></p></c:if><form action="${pageContext.request.contextPath}/register" method="post"><label class="field">Tài khoản<input name="username" value="<c:out value='${registerUsername}'/>" maxlength="100" required></label><label class="field">Mật khẩu<input type="password" name="password" minlength="8" maxlength="255" required></label><label class="field">Email<input type="email" name="email" value="<c:out value='${registerEmail}'/>" maxlength="255" required></label><label class="field">Họ và tên<input name="fullname" value="<c:out value='${registerFullname}'/>" maxlength="255" required></label><label class="field">Số điện thoại<input name="phone" type="tel" value="<c:out value='${registerPhone}'/>" maxlength="12" placeholder="0912345678 hoặc +84912345678"></label><p><button type="submit">Đăng ký</button></p></form><p>Đã có tài khoản? <a href="${pageContext.request.contextPath}/login">Đăng nhập</a></p></main></body></html>

